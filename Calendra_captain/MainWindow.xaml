<Window x:Class="Calendra.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendra"
        Width="300"
        Height="78"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <Grid>
        <Border x:Name="MainBox"
                CornerRadius="18"
                Background="#E6111728"
                BorderBrush="#445D8BFF"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="MainScaleTransform"
                                    ScaleX="1"
                                    ScaleY="1"/>
                    <RotateTransform x:Name="MainRotateTransform"
                                     Angle="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="نمایش / مخفی کردن" Click="ToggleMenu_Click"/>
                    <MenuItem Header="تازه‌سازی جایگاه" Click="RefreshPosition_Click"/>
                    <Separator/>
                    <MenuItem Header="فعال‌سازی اجرای خودکار" Click="EnableStartup_Click"/>
                    <MenuItem Header="حذف از اجرای خودکار" Click="DisableStartup_Click"/>
                    <Separator/>
                    <MenuItem Header="بستن Calendra" Click="Exit_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Border.Effect>
                <DropShadowEffect x:Name="MainShadow"
                                  BlurRadius="22"
                                  ShadowDepth="0"
                                  Opacity="0.42"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="42"/>
                </Grid.ColumnDefinitions>

                <!-- بخش اصلی برنامه -->
                <Grid x:Name="DatePanel"
                      Grid.Column="0"
                      Margin="8,4,4,4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- نوار بالایی -->
                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="22"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Resna24.ir"
                                   Grid.Column="0"
                                   Foreground="#7FA7FF"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Cursor="Hand"
                                   ToolTip="باز کردن سایت‌های تقویم و جستجو"
                                   MouseLeftButtonUp="CalendarTitle_MouseLeftButtonUp"/>

                        <!-- دکمه آیکون تقویم -->
                        <Button x:Name="CalendarIconButton"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                FontSize="13"
                                Padding="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="CalendarIconButton_Click"
                                Background="#22A0A0A0"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTipService.ShowDuration="6000">
                            <Button.ToolTip>
                                <ToolTip Content="باز کردن سایت‌های تقویم و جستجو"/>
                            </Button.ToolTip>
                            <TextBlock Text="📅" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <!-- دکمه راهنمای ماه‌های میلادی -->
                        <Button x:Name="HelpButton"
                                Grid.Column="2"
                                Content="؟"
                                Width="20"
                                Height="20"
                                FontSize="11"
                                Padding="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="HelpButton_Click"
                                Background="#223C6CFF"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTip="تعداد روزهای ماه‌ها، پایان ماه و پایان هفته آمریکا"/>

                        <!-- تنظیمات شخصیت انیمیشن Minimize -->
                        <Button x:Name="SettingsButton"
                                Grid.Column="3"
                                Content="⚙"
                                Width="20"
                                Height="20"
                                FontSize="12"
                                Padding="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="SettingsButton_Click"
                                Background="#224FC3F7"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTip="تنظیم شخصیت و شوخی Minimize"/>

                        <Button Grid.Column="4"
                                Content="─"
                                Width="20"
                                Height="20"
                                FontSize="10"
                                Padding="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="Minimize_Click"
                                Background="#223C6CFF"
                                Foreground="White"
                                BorderThickness="0"/>

                        <Button Grid.Column="5"
                                Content="×"
                                Width="20"
                                Height="20"
                                FontSize="12"
                                Padding="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="Close_Click"
                                Background="#33FF4D6D"
                                Foreground="White"
                                BorderThickness="0"/>

                        <!-- دکمه آیکونی استارتاپ -->
                        <Button x:Name="AddToStartupButton"
                                Grid.Column="6"
                                Width="20"
                                Height="20"
                                FontSize="13"
                                Padding="0"
                                Margin="2,0,0,0"
                                Cursor="Hand"
                                Click="AddToStartupButton_Click"
                                Background="#2250C850"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTipService.ShowDuration="6000">
                            <Button.ToolTip>
                                <ToolTip Content="افزودن برنامه به استارتاپ ویندوز (اجرای خودکار با شروع ویندوز)"/>
                            </Button.ToolTip>
                            <TextBlock Text="⚡" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- تاریخ‌ها -->
                    <Grid Grid.Row="1"
                          VerticalAlignment="Center">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="GregorianDateText"
                                   Grid.Column="0"
                                   Text="----/--/--"
                                   Foreground="#B8C7E8"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FlowDirection="LeftToRight"
                                   MouseLeftButtonUp="DateText_MouseLeftButtonUp"/>

                        <TextBlock x:Name="PersianDateText"
                                   Grid.Column="1"
                                   Text="----/--/--"
                                   Foreground="#FFFFFF"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FlowDirection="RightToLeft"
                                   MouseLeftButtonUp="DateText_MouseLeftButtonUp"/>
                    </Grid>

                    <!-- پنجره کوچک راهنما -->
                    <Popup x:Name="MonthsPopup"
                           PlacementTarget="{Binding ElementName=HelpButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">

                        <Border Background="#F1111728"
                                BorderBrush="#665D8BFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                Width="570"
                                MaxHeight="620">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="0"
                                                  Opacity="0.45"/>
                            </Border.Effect>

                            <ScrollViewer MaxHeight="596"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="GregorianMonthsTitleText"
                                               Text="تعداد روزهای ماه‌های میلادی"
                                               Foreground="#FFFFFF"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>

                                    <TextBlock x:Name="GregorianMonthsHelpText"
                                               Foreground="#DDE7FF"
                                               FontSize="12"
                                               LineHeight="19"
                                               TextAlignment="Left"
                                               FlowDirection="LeftToRight"/>

                                    <Border Height="1"
                                            Margin="0,10,0,9"
                                            Background="#445D8BFF"/>

                                    <TextBlock Text="زمان باقی‌مانده تا پایان ماه جاری"
                                               Foreground="#9FB9F2"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               FlowDirection="RightToLeft"/>

                                    <TextBlock x:Name="MonthCountdownText"
                                               Foreground="#FFFFFF"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FlowDirection="RightToLeft"/>

                                    <Border Height="1"
                                            Margin="0,12,0,9"
                                            Background="#445D8BFF"/>

                                    <TextBlock Text="پایان هفته آمریکا — پایان شنبه به وقت محلی هر منطقه"
                                               Foreground="#9FB9F2"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               FlowDirection="RightToLeft"/>

                                    <TextBlock x:Name="UsWeekCountdownText"
                                               Margin="0,7,0,0"
                                               Foreground="#F3F6FF"
                                               FontSize="11"
                                               LineHeight="20"
                                               TextAlignment="Right"
                                               FlowDirection="RightToLeft"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <!-- تنظیمات شخصیت و شوخی انیمیشن Minimize -->
                    <Popup x:Name="SettingsPopup"
                           PlacementTarget="{Binding ElementName=SettingsButton}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">

                        <Border Background="#FA111827"
                                BorderBrush="#885D8BFF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14"
                                Width="315">

                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24"
                                                  ShadowDepth="0"
                                                  Opacity="0.55"/>
                            </Border.Effect>

                            <StackPanel FlowDirection="RightToLeft">
                                <TextBlock Text="شخصیت انیمیشن Minimize"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="هر انتخاب همان لحظه در config.txt ذخیره می‌شود."
                                           Foreground="#9FB9F2"
                                           FontSize="10"
                                           TextAlignment="Center"
                                           Margin="0,4,0,11"/>

                                <RadioButton x:Name="RandomModeRadio"
                                             GroupName="MinimizeMode"
                                             Tag="Random"
                                             Content="🎲 رندوم — هر بار یک شخصیت متفاوت"
                                             Foreground="White"
                                             FontSize="12"
                                             Margin="3"
                                             Click="MinimizeModeRadio_Click"/>

                                <RadioButton x:Name="HeartbrokenHeroModeRadio"
                                             GroupName="MinimizeMode"
                                             Tag="HeartbrokenHero"
                                             Content="💔 قهرمان دل‌شکسته"
                                             Foreground="White"
                                             FontSize="12"
                                             Margin="3"
                                             Click="MinimizeModeRadio_Click"/>

                                <RadioButton x:Name="BollywoodModeRadio"
                                             GroupName="MinimizeMode"
                                             Tag="Bollywood"
                                             Content="🌹 فیلم هندی"
                                             Foreground="White"
                                             FontSize="12"
                                             Margin="3"
                                             Click="MinimizeModeRadio_Click"/>

                                <RadioButton x:Name="SpaceHeroModeRadio"
                                             GroupName="MinimizeMode"
                                             Tag="SpaceHero"
                                             Content="🚀 قهرمان فضایی"
                                             Foreground="White"
                                             FontSize="12"
                                             Margin="3"
                                             Click="MinimizeModeRadio_Click"/>

                                <RadioButton x:Name="DigitalPetModeRadio"
                                             GroupName="MinimizeMode"
                                             Tag="DigitalPet"
                                             Content="🐾 حیوان خانگی دیجیتال"
                                             Foreground="White"
                                             FontSize="12"
                                             Margin="3"
                                             Click="MinimizeModeRadio_Click"/>

                                <RadioButton x:Name="OfficeWorkerModeRadio"
                                             GroupName="MinimizeMode"
                                             Tag="OfficeWorker"
                                             Content="☕ کارمند مظلوم"
                                             Foreground="White"
                                             FontSize="12"
                                             Margin="3"
                                             Click="MinimizeModeRadio_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- زبانه باز و بسته شدن -->
                <Border Grid.Column="1"
                        x:Name="ToggleHandle"
                        Background="#223C6CFF"
                        CornerRadius="0,18,18,0"
                        Cursor="Hand">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock x:Name="ArrowText"
                                   Text="‹"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="SmallLabelText"
                                   Text="Cal"
                                   Foreground="#DDE7FF"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,1,0,0"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
